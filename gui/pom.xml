<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.jvd</groupId><artifactId>jverifydestroy</artifactId><version>0.1.0</version></parent>
  <artifactId>gui</artifactId>
  <dependencies>
    <dependency><groupId>dev.jvd</groupId><artifactId>txn</artifactId></dependency>
    <dependency><groupId>dev.jvd</groupId><artifactId>destroy-file</artifactId></dependency>
    <dependency><groupId>dev.jvd</groupId><artifactId>evidence</artifactId></dependency>
    <dependency><groupId>dev.jvd</groupId><artifactId>log</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <!--
        Produces one self-contained runnable jar: `java -jar gui-0.1.0.jar`.

        Same rationale as the cli/verifier-cli modules: the desktop app must be
        launchable by somebody who did not clone the repository, without
        assembling a four-entry classpath by hand. Swing itself is JDK-only
        (javax.swing), so shading the project modules is all that is needed —
        no UI dependency is introduced (PLAN §1: JDK-only by design).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.jvd.gui.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The scripted end-to-end run: it opens the real window under a virtual
      display, presses the real button, and saves a screenshot.

      It is a development aid, not a test: it needs a display, so it must never
      run in the headless CI suite. Keeping it in this profile means it is
      compiled only when someone asks for it, and it stays out of the shipped
      jar.

        DISPLAY=:99 ./mvnw -B -Pgui-dev package
        DISPLAY=:99 java -cp gui/target/classes:… dev.jvd.gui.ScriptedRun /tmp/shot.png
    -->
    <profile>
      <id>gui-dev</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-dev-source</id>
                <phase>generate-sources</phase>
                <goals><goal>add-source</goal></goals>
                <configuration>
                  <sources>
                    <source>src/dev/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
